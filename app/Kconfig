menuconfig LED_SUBSYSTEM    #Outermost menuconfig displayed as "LED Subsystem"
bool "LED Subsystem"
default y                   #Set by default

if LED_SUBSYSTEM

config APP_HEARTBEAT_PERIOD_MS         #Kconfig added to be used with app_led
int     "LED Heartbeat Duration(ms)"
default 500
range 100 2000

choice
    prompt "LED blink sleep time"
    default BLINK_SLEEP_TIME_1000MS

config BLINK_SLEEP_TIME_250MS
bool "250ms (very fast)"

config BLINK_SLEEP_TIME_500MS
bool "500ms (fast)"

config BLINK_SLEEP_TIME_1000MS
bool "1s (medium)"

config BLINK_SLEEP_TIME_2000MS
bool "2s (slow)"
endchoice

config BLINK_SLEEP_TIME_MS
int         #Hidden
default 250 if BLINK_SLEEP_TIME_250MS
default 500 if BLINK_SLEEP_TIME_500MS
default 1000 if BLINK_SLEEP_TIME_1000MS
default 2000 if BLINK_SLEEP_TIME_2000MS
default 0

menuconfig ADVANCED_LED_SETTINGS        #Inner menuconfig
bool "Advanced LED settings"
default n

if ADVANCED_LED_SETTINGS                #When enabled, shows LED_BRIGHTNESS, LED_FADE_DURATION and Expert Settings

config LED_BRIGHTNESS
int "LED brightness (0-100)"
default 100
range 0 100                             

config LED_FADE_DURATION
int "LED fade duration (ms)"
default 500
range 0 5000

menu "Expert Settings"
    visible if ADVANCED_LED_SETTINGS

config ENABLE_LED_DEBUGGING
bool "Enable LED debugging"

config CUSTOM_BLINK_PATTERN
bool "Custom blink pattern"

endmenu
endif
endif
source "Kconfig.zephyr"